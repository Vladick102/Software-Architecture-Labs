<?xml version="1.0" encoding="UTF-8"?>
<hazelcast xmlns="http://www.hazelcast.com/schema/config"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.hazelcast.com/schema/config
           https://hazelcast.com/schema/config/hazelcast-config-5.3.xsd">

    <cluster-name>dev</cluster-name>

    <network>
        <port auto-increment="true" port-count="10">5701</port>
        <join>
            <multicast enabled="false"/>
            <tcp-ip enabled="true">
                <member>hazelcast1:5701</member>
                <member>hazelcast2:5701</member>
                <member>hazelcast3:5701</member>
            </tcp-ip>
        </join>
    </network>

    <map name="default">
        <backup-count>1</backup-count>
        <async-backup-count>0</async-backup-count>
    </map>

    <map name="lock-demo">
        <backup-count>1</backup-count>
    </map>

    <map name="capitals">
        <backup-count>1</backup-count>
    </map>

    <queue name="bounded-queue">
        <max-size>10</max-size>
        <backup-count>1</backup-count>
        <async-backup-count>0</async-backup-count>
        <empty-queue-ttl>-1</empty-queue-ttl>
    </queue>

</hazelcast>
